---
const { title = "Ibarron — Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <style>
      :root {
        --bg: #0b0b0c;
        --fg: #f3f3f3;
        --muted: #9aa0a6;
        --line: #1e1e22;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
        scroll-behavior: smooth;
      }

      body {
        min-height: 100%;
        margin: 0;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
        background: var(--bg);
        color: var(--fg);
      }

      /* =========================
         LAYOUT
         ========================= */

      .layout {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
        width: 100%;
        max-width: 1100px;
        margin: 48px auto;
        padding: 0 24px;
      }

      /* =========================
         NAVIGATION
         ========================= */

      nav {
        position: sticky;
        top: 0;
        z-index: 1000;

        width: 100%;
        background: rgba(11, 11, 12, 0.92);

        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);

        border-bottom: 1px solid var(--line);
      }

      .nav-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 16px 24px;

        display: flex;
        align-items: center;
        gap: 24px;
      }

      .brand {
        font-weight: 600;
        letter-spacing: 0.3px;
        color: var(--fg);
        text-decoration: none;
      }

      .links {
        margin-left: auto;
        display: flex;
        gap: 16px;
      }

      .links a {
        color: var(--muted);
        font-size: 14px;
        text-decoration: none;
        transition: color 180ms ease;
      }

      .links a:hover {
        color: var(--fg);
      }

      h1 {
        margin: 0 0 12px;
        font-size: 36px;
      }

      p {
        color: var(--muted);
        line-height: 1.6;
      }

      /* =========================
         FOOTER
         ========================= */

      .site-footer {
        padding: 40px 0;
        border-top: 1px solid var(--line);
      }

      .footer-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 24px;

        display: flex;
        justify-content: space-between;
        align-items: flex-end;
      }

      .footer-name {
        margin: 0 0 4px;
        font-size: 14px;
        color: var(--fg);
      }

      .footer-role {
        margin: 0;
        font-size: 12px;
        color: var(--muted);
      }

      .footer-right {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
      }

      .footer-right a {
        font-size: 12px;
        color: var(--muted);
        text-decoration: none;
        transition: color 180ms ease;
      }

      .footer-right a:hover {
        color: var(--fg);
      }

      /* =========================
         LIGHTBOX
         ========================= */

      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 2000;

        display: none;
        align-items: center;
        justify-content: center;

        padding: 32px;
        background: rgba(0, 0, 0, 0.92);
        cursor: zoom-out;
      }

      .lightbox.show {
        display: flex;
      }

      .lightbox img {
        display: block;
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
      }

      .zoomable {
        cursor: zoom-in;
      }

      /* =========================
         RESPONSIVE
         ========================= */

      @media (max-width: 700px) {
        main {
          margin: 32px auto;
          padding: 0 16px;
        }

        .nav-inner {
          padding: 14px 16px;
        }

        .footer-inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 20px;
          padding: 0 16px;
        }
      }
    </style>
  </head>

  <body>
    <div class="layout">
      <nav aria-label="Main navigation">
        <div class="nav-inner">
          <a class="brand" href="/">Ibarron</a>

          <div class="links">
            <a href="/work">Work</a>
            <a href="/about">About</a>
          </div>
        </div>
      </nav>

      <main id="top">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <div>
            <p class="footer-name">Juan Pablo Ibarron</p>

            <p class="footer-role">
              3D Artist · Modeling · Rigging · Animation
            </p>
          </div>

          <div class="footer-right">
            <a
              href="https://www.behance.net/juanpabloibarron"
              target="_blank"
              rel="noopener noreferrer"
            >
              Behance
            </a>

            <a
              href="https://www.instagram.com/juanpabloibarron"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>

            <a
              href="https://www.tiktok.com/@ibarron_"
              target="_blank"
              rel="noopener noreferrer"
            >
              TikTok
            </a>

            <a href="#top">Back to top</a>
          </div>
        </div>
      </footer>
    </div>

    <div
      id="lightbox"
      class="lightbox"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-label="Expanded image"
    >
      <img id="lightbox-img" alt="" />
    </div>

    <script>
  const lightbox = document.getElementById("lightbox") as HTMLDivElement | null;
  const lightboxImg = document.getElementById(
    "lightbox-img"
  ) as HTMLImageElement | null;

  const closeLightbox = () => {
    if (!lightbox || !lightboxImg) return;

    lightbox.classList.remove("show");
    lightbox.setAttribute("aria-hidden", "true");
    lightboxImg.removeAttribute("src");
    lightboxImg.alt = "";
    document.body.style.overflow = "";
  };

  if (lightbox && lightboxImg) {
    document.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof HTMLElement)) return;

      if (
        target instanceof HTMLImageElement &&
        target.classList.contains("zoomable")
      ) {
        lightboxImg.src = target.currentSrc || target.src;
        lightboxImg.alt = target.alt || "Expanded project image";

        lightbox.classList.add("show");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";

        return;
      }

      if (target === lightbox || target === lightboxImg) {
        closeLightbox();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeLightbox();
      }
    });
  }
</script>