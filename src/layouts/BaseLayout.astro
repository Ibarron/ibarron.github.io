---
const { title = "Ibarron — Portfolio" } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root{
        --bg:#0b0b0c;
        --fg:#f3f3f3;
        --muted:#9aa0a6;
        --line:#1e1e22;
      }
      *{ box-sizing:border-box; }
      body{
        margin:0;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        background:var(--bg);
        color:var(--fg);
      }
      nav{
        position:sticky;
        top:0;
        background:rgba(11,11,12,.9);
        backdrop-filter: blur(10px);
        border-bottom:1px solid var(--line);
      }
      .nav-inner{
        max-width:1100px;
        margin:0 auto;
        padding:16px 24px;
        display:flex;
        align-items:center;
        gap:24px;
      }
      .brand{
        font-weight:600;
        letter-spacing:.3px;
      }
      .links{
        margin-left:auto;
        display:flex;
        gap:16px;
      }
      .links a{
        color:var(--muted);
        font-size:14px;
        text-decoration:none;
      }
      .links a:hover{
        color:var(--fg);
      }
      main{
        max-width:1100px;
        margin:48px auto;
        padding:0 24px;
      }
      h1{
        font-size:36px;
        margin:0 0 12px;
      }
      p{
        color:var(--muted);
        line-height:1.6;
      }
    </style>
  </head>

  <body>
    <nav>
      <div class="nav-inner">
        <a class="brand" href="/">ibarron</a>
        <div class="links">
          <a href="/work">Work</a>
          <a href="/about">About</a>
          <a href="/resume">Resume</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>
  </body>
</html>
