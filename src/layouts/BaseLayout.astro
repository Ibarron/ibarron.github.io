---
const { title = "Ibarron — Portfolio" } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <style>
      :root{
        --bg:#0b0b0c;
        --fg:#f3f3f3;
        --muted:#9aa0a6;
        --line:#1e1e22;
      }

      *{ box-sizing:border-box; }

      html, body{
        height:100%;
      }

      body{
        margin:0;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        background:var(--bg);
        color:var(--fg);
      }

      /* Layout */
      .layout{
        min-height:100vh;
        display:flex;
        flex-direction:column;
      }

      main{
        flex:1;
        max-width:1100px;
        margin:48px auto;
        padding:0 24px;
      }

      /* Nav */
      nav{
        position:sticky;
        top:0;
        background:rgba(11,11,12,.9);
        backdrop-filter: blur(10px);
        border-bottom:1px solid var(--line);
      }

      .nav-inner{
        max-width:1100px;
        margin:0 auto;
        padding:16px 24px;
        display:flex;
        align-items:center;
        gap:24px;
      }

      .brand{
        font-weight:600;
        letter-spacing:.3px;
        color:var(--fg);
        text-decoration:none;
      }

      .links{
        margin-left:auto;
        display:flex;
        gap:16px;
      }

      .links a{
        color:var(--muted);
        font-size:14px;
        text-decoration:none;
      }

      .links a:hover{
        color:var(--fg);
      }

      h1{
        font-size:36px;
        margin:0 0 12px;
      }

      p{
        color:var(--muted);
        line-height:1.6;
      }

      /* Footer */
      .site-footer {
        padding: 40px 0;
        border-top: 1px solid var(--line);
      }


      .footer-inner{
        display:flex;
        justify-content:space-between;
        align-items:flex-end;
        max-width:1100px;
        margin:0 auto;
        padding:0 24px;
      }

      .footer-name{
        font-size:14px;
        margin-bottom:4px;
      }

      .footer-role{
        font-size:12px;
        color:var(--muted);
      }

      .footer-right{
        display:flex;
        gap:16px;
      }

      .footer-right a{
        font-size:12px;
        color:var(--muted);
        text-decoration:none;
      }

      .footer-right a:hover{
        color:var(--fg);
      }

      @media (max-width:700px){
        .footer-inner{
          flex-direction:column;
          gap:20px;
          align-items:flex-start;
        }
      }
    </style>
  </head>

  <body>
    <div class="layout">
      <nav>
        <div class="nav-inner">
          <a class="brand" href="/">ibarron</a>
          <div class="links">
            <a href="/work">Work</a>
            <a href="/about">About</a>
            <a href="/resume">Resume</a>
          </div>
        </div>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <div>
            <p class="footer-name">Juan Pablo Ibarron</p>
            <p class="footer-role">3D Artist · Modeling · Rigging · Animation</p>
          </div>

          <div class="footer-right">
            <a href="https://www.behance.net/juanpabloibarron" target="_blank">Behance</a>
            <a href="https://www.instagram.com/" target="_blank">Instagram</a>
            <a href="https://www.linkedin.com/" target="_blank">LinkedIn</a>
            <a href="#top">Back to top</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
