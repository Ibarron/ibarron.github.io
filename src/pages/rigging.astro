---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    number: "01",
    title: "Wolf Character Rig",
    category: "Full Character Rig · IK/FK · Facial Controls",
    description:
      "A complete production-ready quadruped rig featuring IK/FK switching, stretch controls, space switching, facial controls and animation-friendly deformation.",
    video: "/work/Wolf_Rigging/Rig_body.mp4",
    image: "/work/rigging/wolf/wolf-rig-hero.jpg",
    link: "/projects/Wolf_Rigging",
  },

  /*
    {
    number: "02",
    title: "Minotaur Facial Rig",
    category: "Facial Rigging · Shape Keys · Animation Controls",
    description:
      "A facial rig focused on expressive deformation, shape key control and animator-friendly facial poses for a stylized minotaur character.",
    video: "/work/minotaur/minotaur-face-preview.mp4",
    image: "/work/minotauro_rig/minotauro.png",
    link: "/projects/minotaur-facial-rig",
  },
*/
];
---

<BaseLayout title="Rigging — Juan Pablo Ibarron">
  <main class="rigging-page">

    <section class="rigging-hero">
      <p class="eyebrow">SELECTED DISCIPLINE</p>

      <h1>Rigging<span>.</span></h1>

      <div class="hero-bottom">
        <p class="intro">
          A selection of character rigs developed with a focus on clean
          deformation, intuitive controls and animation-ready workflows.
        </p>

        <p class="project-count">
          {String(projects.length).padStart(2, "0")} PROJECTS
        </p>
      </div>
    </section>

    <section class="project-list">
      {
        projects.map((project) => (
          <article class="project">
            <a href={project.link} class="project-link">

              <div class="project-heading">
                <p class="project-number">{project.number}</p>

                <div>
                  <h2>{project.title}</h2>
                  <p class="category">{project.category}</p>
                </div>

                <span class="arrow" aria-hidden="true">↗</span>
              </div>

              <div class="project-media">
                {
                  project.video ? (
                    <video
                      src={project.video}
                      poster={project.image}
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      aria-label={`${project.title} project preview`}
                    >
                      Your browser does not support the video tag.
                    </video>
                  ) : (
                    <img
                      src={project.image}
                      alt={`${project.title} project`}
                      loading="lazy"
                    />
                  )
                }
              </div>

              <div class="project-footer">
                <p>{project.description}</p>

                <span class="view-project">
                  View project
                  <span aria-hidden="true">→</span>
                </span>
              </div>

            </a>
          </article>
        ))
      }
    </section>

  </main>
</BaseLayout>

<style>
  .rigging-page {
    width: min(100% - 48px, 1440px);
    max-width: none;
    margin: 0 auto;
    padding: 100px 0 140px;
  }

  .rigging-hero {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 72px;
    border-bottom: 1px solid var(--line, #292929);
  }

  .eyebrow {
    margin: 0;
    color: var(--muted, #888);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .rigging-hero h1 {
    margin: 70px 0;
    font-size: clamp(82px, 15vw, 220px);
    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.065em;
  }

  .rigging-hero h1 span {
    color: var(--muted, #777);
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 700px) auto;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
  }

  .intro {
    margin: 0;
    color: var(--muted, #a5a5a5);
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1.45;
  }

  .project-count {
    margin: 0;
    color: var(--muted, #888);
    font-size: 12px;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  .project-list {
    display: flex;
    flex-direction: column;
  }

  .project {
    padding: 78px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .project-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project-heading {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    align-items: start;
    gap: 24px;
    margin-bottom: 34px;
  }

  .project-number {
    margin: 9px 0 0;
    color: var(--muted, #777);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .project-heading h2 {
    margin: 0 0 12px;
    font-size: clamp(38px, 5vw, 78px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .category {
    margin: 0;
    color: var(--muted, #999);
    font-size: 14px;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line, #333);
    border-radius: 50%;
    font-size: 21px;
    transition:
      transform 250ms ease,
      background-color 250ms ease,
      color 250ms ease;
  }

  .project-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
  }

  .project-media img,
  .project-media video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition:
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 400ms ease;
  }

  .project-media video {
    pointer-events: none;
  }

  .project-footer {
    display: grid;
    grid-template-columns: minmax(0, 700px) auto;
    justify-content: space-between;
    align-items: start;
    gap: 40px;
    margin-top: 26px;
  }

  .project-footer p {
    margin: 0;
    color: var(--muted, #999);
    line-height: 1.65;
  }

  .view-project {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
    font-size: 14px;
  }

  .project-link:hover .project-media img,
  .project-link:hover .project-media video {
    transform: scale(1.025);
    filter: brightness(1.07);
  }

  .project-link:hover .arrow {
    transform: rotate(45deg);
    background: #f2f2f2;
    color: #111;
  }

  @media (max-width: 800px) {
    .rigging-page {
      width: min(100% - 30px, 1440px);
      padding-top: 70px;
    }

    .rigging-hero {
      min-height: 58vh;
      padding-bottom: 48px;
    }

    .rigging-hero h1 {
      margin: 70px 0;
    }

    .hero-bottom,
    .project-footer {
      grid-template-columns: 1fr;
    }

    .project-count {
      display: none;
    }

    .project {
      padding: 56px 0;
    }

    .project-heading {
      grid-template-columns: 42px 1fr;
    }

    .arrow {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .rigging-page {
      width: min(100% - 24px, 1440px);
    }

    .rigging-hero h1 {
      font-size: 68px;
    }

    .project-heading {
      grid-template-columns: 1fr;
    }

    .project-number {
      margin: 0;
    }

    .project-media {
      aspect-ratio: 4 / 5;
    }
  }
</style>