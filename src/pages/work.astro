---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
     title: "Lobo – Retopología para animación 3D",
     role: "Modelado · Retopología",
      year: "2025",
       href: "/projects/lobo-retopologia",
  },
  {
    title: "Serpent Icon – 3D Animation",
    role: "Animación · Blender",
    year: "2025",
    href: "/projects/serpent-animation",
  },
  {
    title: "Longneck – Character Design",
    role: "Modelado 3D",
    year: "2024",
    href: "/projects/longneck-character",
  },
  {
    title: "Christmasaur – T-Rex Fan Art",
    role: "Modelado · Sculpt",
    year: "2024",
    href: "/projects/christmasaur-fanart",
  },
  {
    title: "Estación de Mixcoac",
    role: "3D / Render",
    year: "2024",
    href: "/projects/estacion-mixcoac",
  },
];

---

<BaseLayout title="Work — Ibarron">
  <h1>Work</h1>
  <p>Selección de proyectos.</p>

  <div class="grid">
    {projects.map(project => (
      <a class="project" href={project.href}>
        <div class="project-inner">
          <h3>{project.title}</h3>
          <p>{project.role}</p>
          <span>{project.year}</span>
        </div>
      </a>
    ))}
  </div>

<style>
  .grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .project {
    border: 1px solid #1e1e22;
    text-decoration: none;
    color: inherit;
    transition: border-color .2s ease;
  }

  .project:hover {
    border-color: #f3f3f3;
  }

  .project-inner {
    padding: 24px;
  }

  .project h3 {
    margin: 0 0 12px;
    font-size: 18px;
    font-weight: 500;
  }

  .project p {
    margin: 0;
    font-size: 14px;
    color: #9aa0a6;
  }

  .project span {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    color: #6f737a;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

