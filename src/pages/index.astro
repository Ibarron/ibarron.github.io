---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Juan Pablo Ibarron — 3D Artist">
  <section class="hero">
    <h1>Juan Pablo Ibarron</h1>
    <p class="role">
      3D Artist · Modeling · Rigging · Animation
    </p>

    <p class="intro">
      Specialized in creating animation-ready 
      3D characters and models, with a strong focus 
      on rigging, animation, and production-ready workflows.
    </p>

    <div class="actions">
      <a href="/work" class="btn primary">Works</a>
      <a href="/about" class="btn">About me</a>
    </div>
  </section>
  <section class="contact">
  <span class="eyebrow">CONTACT</span>

  <h2>Let’s talk about your next project</h2>

  <p class="email">Email: juanpabloibarron99@gmail.com</p>

  <button class="copy-btn" onclick="navigator.clipboard.writeText('juanpabloibarron99@gmail.com')">
    Copy email address
  </button>

  <p class="contact-note">
   Open to collaborations on 3D character modeling,
    rigging, and animation — from early ideas to final production.
  </p>
</section>
</BaseLayout>




<style>
.contact {
  margin-top: 120px;
  padding-top: 80px;
  border-top: 1px solid #1e1e22;
  text-align: center;
}

.eyebrow {
  display: block;
  font-size: 12px;
  letter-spacing: 0.12em;
  color: #9aa0a6;
  margin-bottom: 12px;
}

.contact h2 {
  font-size: 36px;
  margin-bottom: 16px;
}

.email {
  margin-bottom: 16px;
  font-size: 16px;
  color: #cfcfcf;
}

.copy-btn {
  border: 1px solid #f3f3f3;
  background: transparent;
  color: #f3f3f3;
  padding: 10px 18px;
  cursor: pointer;
  margin-bottom: 24px;
}

.copy-btn:hover {
  background: #f3f3f3;
  color: #000;
}

.contact-note {
  max-width: 520px;
  margin: 0 auto;
  font-size: 14px;
  line-height: 1.6;
  color: #9aa0a6;
}

  .hero {
    max-width: 760px;
  }

  .role {
    margin-top: 12px;
    font-size: 16px;
    color: #9aa0a6;
  }

  .intro {
    margin-top: 24px;
    line-height: 1.6;
    color: #cfcfcf;
  }

  .actions {
    margin-top: 32px;
    display: flex;
    gap: 16px;
  }

  .btn {
    border: 1px solid #1e1e22;
    padding: 10px 18px;
    text-decoration: none;
    color: #f3f3f3;
    font-size: 14px;
  }

  .btn.primary {
    border-color: #f3f3f3;
  }

  .btn:hover {
    border-color: #ffffff;
  }
</style>
