---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Juan Pablo Ibarron — 3D Artist">
  <section class="hero">
    <p class="kicker">JUAN PABLO IBARRON · 3D ARTIST</p>

    <h1>
      Creating characters<br />
      built to move.
    </h1>

    <p class="intro">
      I create animation-ready 3D characters and models, with a strong focus on
      modeling, rigging, animation, and production-ready workflows.
    </p>

    <nav class="service-buttons" aria-label="Portfolio disciplines">
      <a href="/modeling" class="service-btn">Modeling/Texture</a>
      <a href="/work" class="service-btn">Rigging</a>
      <a href="/work" class="service-btn">Animation</a>
      <a href="/about" class="service-btn">About Me</a>
    </nav>
  </section>

  <section class="contact">
    <span class="eyebrow">CONTACT</span>

    <h2>Let’s talk about your next project</h2>

    <p class="email">
      Email:
      <a href="mailto:juanpabloibarron99@gmail.com">
        juanpabloibarron99@gmail.com
      </a>
    </p>

    <button
      class="copy-btn"
      type="button"
      data-email="juanpabloibarron99@gmail.com"
    >
      Copy email address
    </button>

    <p class="contact-note">
      Open to collaborations on 3D character modeling, rigging, and animation —
      from early ideas to final production.
    </p>
  </section>
</BaseLayout>

<script>
  const copyButton = document.querySelector(".copy-btn");

  copyButton?.addEventListener("click", async () => {
    const email = copyButton.getAttribute("data-email");

    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      copyButton.textContent = "Email copied";

      window.setTimeout(() => {
        copyButton.textContent = "Copy email address";
      }, 1800);
    } catch {
      copyButton.textContent = email;
    }
  });
</script>

<style>
  .hero {
    width: 100%;
    min-height: 68vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 72px 0 96px;
  }

  .kicker {
    margin: 0 0 24px;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: #9aa0a6;
  }

  .hero h1 {
    max-width: 980px;
    margin: 0;
    font-size: clamp(38px, 10vw, 106px);
    line-height: 0.9;
    letter-spacing: -0.065em;
    font-weight: 650;
  }

  .intro {
    max-width: 680px;
    margin: 48px 0 0;
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.7;
    color: #cfcfcf;
  }

  .service-buttons {
    display: grid;
    grid-template-columns: repeat(4, max-content);
    gap: 16px;
    margin-top: 36px;
  }

  .service-btn {
    min-width: 132px;
    padding: 14px 22px;
    border: 1px solid #2a2a2f;
    background: transparent;
    color: #f3f3f3;
    font-size: 14px;
    text-align: center;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .service-btn:hover {
    border-color: #f3f3f3;
    background: #f3f3f3;
    color: #0b0b0c;
    transform: translateY(-2px);
  }

  .contact {
    margin-top: 80px;
    padding: 96px 0 24px;
    border-top: 1px solid #1e1e22;
    text-align: center;
  }

  .eyebrow {
    display: block;
    margin-bottom: 16px;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: #9aa0a6;
  }

  .contact h2 {
    max-width: 760px;
    margin: 0 auto 20px;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .email {
    margin-bottom: 20px;
    font-size: 16px;
    color: #cfcfcf;
  }

  .email a {
    color: inherit;
    text-decoration: none;
  }

  .email a:hover {
    color: #ffffff;
  }

  .copy-btn {
    margin-bottom: 28px;
    padding: 13px 22px;
    border: 1px solid #f3f3f3;
    background: transparent;
    color: #f3f3f3;
    font-size: 13px;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .copy-btn:hover {
    background: #f3f3f3;
    color: #0b0b0c;
  }

  .contact-note {
    max-width: 560px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.7;
    color: #9aa0a6;
  }

  @media (max-width: 800px) {
    .hero {
      min-height: auto;
      padding: 48px 0 72px;
    }

    .service-buttons {
      grid-template-columns: repeat(2, 1fr);
      width: 100%;
    }

    .service-btn {
      min-width: 0;
    }
  }

  @media (max-width: 480px) {
    .service-buttons {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .intro {
      margin-top: 36px;
    }

    .contact {
      padding-top: 64px;
    }
  }
</style>