---
import BaseLayout from "../../layouts/BaseLayout.astro";

const gallery = [
  {
    src: "/work/modeling/christmas/christmas-hero.png",
    alt: "Final render of the Christmas dinosaur scene",
  },
  {
    src: "/work/modeling/christmas/christmas-detail-01.png",
    alt: "Close-up of the stylized Christmas dinosaur characters",
  },
  {
    src: "/work/modeling/christmas/christmas-detail-02.png",
    alt: "Holiday scene lighting and environment details",
  },
];

const characters = [
  {
    src: "/work/modeling/christmas/character-01.png",
    alt: "Stylized dinosaur character one",
  },
  {
    src: "/work/modeling/christmas/character-02.png",
    alt: "Stylized dinosaur character two",
  },
  {
    src: "/work/modeling/christmas/character-03.png",
    alt: "Stylized dinosaur character three",
  },
];
---

<BaseLayout title="Christmas Project — Juan Pablo Ibarron">
  <main class="project-page">

    <section class="project-hero">
      <div class="hero-meta">
        <p class="eyebrow">CHARACTER MODELING · LIGHTING · SCENE ASSEMBLY</p>
        <p class="year">2026</p>
      </div>

      <h1>Christmas Project<span>.</span></h1>

      <div class="hero-description">
        <p>
          A stylized holiday scene created during my internship at Cloud 10
          Studio, featuring three original dinosaur characters developed for a
          festive cinematic composition.
        </p>

        <p>
          The project focused on character modeling, look development,
          environment assembly, lighting and final rendering.
        </p>
      </div>
    </section>

    <section class="hero-media">
      <img
        src="/work/modeling/christmas/christmas-hero.png"
        alt="Final Christmas dinosaur scene"
        class="zoomable"
      />
    </section>

    <section class="project-overview">
      <div>
        <p class="section-label">PROJECT</p>
        <h2>Stylized Character Scene</h2>
      </div>

      <div class="overview-copy">
        <p>
          The scene was designed as a playful Christmas environment built
          around three stylized dinosaur characters. Each character was created
          with a distinct silhouette and personality while maintaining a
          consistent visual language across the collection.
        </p>

        <p>
          The final composition combines warm fireplace lighting, colorful
          decorative lights and holiday props to create a cozy and narrative
          driven render.
        </p>
      </div>
    </section>

    <section class="details-grid">
      <article>
        <p class="section-label">ROLE</p>
        <p>
          Character Modeling<br />
          Look Development<br />
          Scene Assembly<br />
          Lighting<br />
          Rendering
        </p>
      </article>

      <article>
        <p class="section-label">SOFTWARE</p>
        <p>
          Blender<br />
            Texture Workflow<br />
          Cycles
        </p>
      </article>

      <article>
        <p class="section-label">STUDIO</p>
        <p>
          Cloud 10 Studio<br />
          Contest Project
        </p>
      </article>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="section-label">CHARACTERS</p>
        <h2>Three original stylized dinosaurs</h2>
      </div>

      <div class="character-grid">
        {
          characters.map((character) => (
            <figure>
              <img
                src={character.src}
                alt={character.alt}
                class="zoomable"
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="section-label">FINAL SCENE</p>
        <h2>Lighting and visual storytelling</h2>
      </div>

      <div class="gallery-grid">
        {
          gallery.map((image) => (
            <figure>
              <img
                src={image.src}
                alt={image.alt}
                class="zoomable"
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>
    </section>

    <section class="process-section">
      <div class="section-heading">
        <p class="section-label">PROCESS</p>
        <h2>From character design to final render</h2>
      </div>

      <div class="process-grid">
        <article>
          <span>01</span>
          <h3>Character Modeling</h3>
          <p>
            Each dinosaur was built with a clear silhouette, exaggerated
            proportions and a stylized character language.
          </p>
        </article>

        <article>
          <span>02</span>
          <h3>Look Development</h3>
          <p>
            Materials and colors were developed to keep the characters playful,
            readable and visually consistent.
          </p>
        </article>

        <article>
          <span>03</span>
          <h3>Scene Assembly</h3>
          <p>
            The fireplace, decorations and holiday props were arranged to frame
            the characters and support the composition.
          </p>
        </article>

        <article>
          <span>04</span>
          <h3>Lighting</h3>
          <p>
            Warm firelight and cooler decorative lights were combined to create
            contrast, depth and a festive atmosphere.
          </p>
        </article>
      </div>
    </section>

    <section class="next-project">
      <p class="section-label">NEXT PROJECT</p>

      <a href="/projects/mixcoac-station">
        <span>Mixcoac Station</span>
        <span aria-hidden="true">→</span>
      </a>
    </section>

  </main>
</BaseLayout>

<style>
  .project-page {
    width: min(100% - 48px, 1440px);
    max-width: none;
    margin: 0 auto;
    padding: 100px 0 140px;
  }

  .project-hero {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 72px;
    border-bottom: 1px solid var(--line, #292929);
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }

  .eyebrow,
  .year,
  .section-label {
    margin: 0;
    color: var(--muted, #888);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .project-hero h1 {
    margin: 70px 0;
    max-width: 1200px;
    font-size: clamp(72px, 12vw, 180px);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.065em;
  }

  .project-hero h1 span {
    color: var(--muted, #777);
  }

  .hero-description {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 520px));
    justify-content: space-between;
    gap: 48px;
  }

  .hero-description p {
    margin: 0;
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.5;
  }

  .hero-media {
    margin-top: 80px;
  }

  .hero-media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
  }

  .project-overview {
    display: grid;
    grid-template-columns: minmax(260px, 0.7fr) minmax(0, 1.3fr);
    gap: 80px;
    padding: 110px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .project-overview h2,
  .section-heading h2 {
    margin: 18px 0 0;
    font-size: clamp(38px, 5vw, 72px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .overview-copy {
    display: grid;
    gap: 24px;
  }

  .overview-copy p {
    margin: 0;
    max-width: 760px;
    font-size: 18px;
    line-height: 1.7;
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    padding: 64px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .details-grid article p:last-child {
    margin: 18px 0 0;
    color: var(--fg, #f3f3f3);
    line-height: 1.8;
  }

  .section-block,
  .process-section {
    padding: 110px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .section-heading {
    margin-bottom: 48px;
  }

  .character-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .character-grid figure,
  .gallery-grid figure {
    margin: 0;
    overflow: hidden;
    background: #111;
  }

  .character-grid img,
  .gallery-grid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .character-grid img {
    aspect-ratio: 4 / 5;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 18px;
  }

  .gallery-grid figure:first-child {
    grid-row: span 2;
  }

  .gallery-grid img {
    aspect-ratio: 16 / 10;
  }

  .gallery-grid figure:first-child img {
    aspect-ratio: auto;
    min-height: 100%;
  }

  .character-grid figure:hover img,
  .gallery-grid figure:hover img {
    transform: scale(1.02);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .process-grid article {
    padding-top: 24px;
    border-top: 1px solid var(--line, #292929);
  }

  .process-grid span {
    color: var(--muted, #777);
    font-size: 12px;
    letter-spacing: 0.16em;
  }

  .process-grid h3 {
    margin: 22px 0 14px;
    font-size: 22px;
    font-weight: 500;
  }

  .process-grid p {
    margin: 0;
    line-height: 1.65;
  }

  .next-project {
    padding-top: 90px;
  }

  .next-project a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-top: 28px;
    padding: 36px 0;
    color: inherit;
    text-decoration: none;
    border-top: 1px solid var(--line, #292929);
    border-bottom: 1px solid var(--line, #292929);
  }

  .next-project a span:first-child {
    font-size: clamp(36px, 6vw, 84px);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .next-project a span:last-child {
    font-size: 40px;
    transition: transform 200ms ease;
  }

  .next-project a:hover span:last-child {
    transform: translateX(8px);
  }

  @media (max-width: 900px) {
    .project-page {
      width: min(100% - 30px, 1440px);
      padding-top: 70px;
    }

    .project-hero {
      min-height: 60vh;
    }

    .hero-description,
    .project-overview {
      grid-template-columns: 1fr;
    }

    .details-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-grid figure:first-child {
      grid-row: auto;
    }
  }

  @media (max-width: 620px) {
    .project-page {
      width: min(100% - 24px, 1440px);
    }

    .project-hero h1 {
      font-size: 58px;
    }

    .hero-meta {
      flex-direction: column;
    }

    .details-grid,
    .character-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .hero-media img {
      aspect-ratio: 4 / 5;
    }

    .section-block,
    .process-section,
    .project-overview {
      padding: 80px 0;
    }
  }
</style>