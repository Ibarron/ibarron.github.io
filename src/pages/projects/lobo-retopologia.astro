---
import BaseLayout from "../../layouts/BaseLayout.astro";

const topologyImages = [
  {
    src: "/work/lobo-retopo/wolf_6.png",
    alt: "Full-body topology view of the wolf character",
  },
  {
    src: "/work/lobo-retopo/wolf_5.png",
    alt: "Close-up topology view showing facial edge flow",
  },
];

const comparisonImages = [
  {
    src: "/work/lobo-retopo/06-before.png",
    alt: "High-poly wolf sculpt before retopology",
    label: "High-poly sculpt",
  },
  {
    src: "/work/lobo-retopo/Retopology_wolf.png",
    alt: "Retopologized wolf mesh prepared for animation",
    label: "Production mesh",
  },
];
---

<BaseLayout title="Wolf Character — Retopology">
  <article class="project-page">

    <header class="project-hero">
      <div class="hero-meta">
        <p class="eyebrow">CHARACTER MODELING · RETOPOLOGY</p>
        <p class="year">2025</p>
      </div>

      <h1>Wolf Character<span>.</span></h1>

      <div class="hero-bottom">
        <p class="hero-description">
          A stylized quadruped character developed from high-poly sculpting to
          a clean, production-ready mesh prepared for rigging and animation.
        </p>

        <a class="back-link" href="/modeling">
          Back to Modeling
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <section class="hero-image">
      <img
        src="/work/lobo-retopo/wolf_front.png"
        alt="Final high-poly sculpt of the stylized wolf character"
        class="zoomable"
      />
    </section>

    <section class="overview-section">
      <div class="section-heading">
        <p class="section-label">OVERVIEW</p>
        <h2>From sculpt to production mesh</h2>
      </div>

      <div class="overview-copy">
        <p>
          This project explores the complete character modeling process, with a
          particular focus on creating clean topology for deformation and
          animation.
        </p>

        <p>
          The original sculpt was rebuilt manually, preserving its stylized
          proportions while creating an efficient mesh with controlled edge
          flow around the face, neck, shoulders and limbs.
        </p>
      </div>
    </section>

    <section class="project-details">
      <article>
        <p class="section-label">ROLE</p>
        <p>
          Character Sculpting<br />
          Manual Retopology<br />
          Rig Preparation
        </p>
      </article>

      <article>
        <p class="section-label">SOFTWARE</p>
        <p>Blender</p>
      </article>

      <article>
        <p class="section-label">FOCUS</p>
        <p>
          Clean Edge Flow<br />
          Deformation Areas<br />
          Animation-Ready Mesh
        </p>
      </article>
    </section>

    <section class="content-section">
      <div class="section-heading">
        <p class="section-label">TOPOLOGY</p>
        <h2>Clean edge flow for deformation</h2>

        <p class="section-intro">
          The topology was designed to support facial movement, limb
          articulation and clean deformation while keeping the mesh efficient.
        </p>
      </div>

      <div class="topology-grid">
        {
          topologyImages.map((image) => (
            <figure>
              <img
                src={image.src}
                alt={image.alt}
                class="zoomable"
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>
    </section>

    <section class="content-section comparison-section">
      <div class="section-heading">
        <p class="section-label">COMPARISON</p>
        <h2>High poly and production mesh</h2>

        <p class="section-intro">
          The final retopology preserves the main volumes and silhouette of the
          sculpt while creating a lighter and more controllable structure.
        </p>
      </div>

      <div class="comparison-grid">
        {
          comparisonImages.map((image) => (
            <figure>
              <div class="image-wrapper">
                <img
                  src={image.src}
                  alt={image.alt}
                  class="zoomable"
                  loading="lazy"
                />
              </div>

              <figcaption>{image.label}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="reflection-section">
      <p class="section-label">OUTCOME</p>

      <p class="reflection-text">
        This project strengthened my understanding of quadruped anatomy,
        deformation-friendly topology and the preparation of stylized
        characters for rigging and animation workflows.
      </p>
    </section>

    <section class="next-project">
      <p class="section-label">NEXT PROJECT</p>

      <a href="/projects/mixcoac-station">
        <span>Mixcoac Station</span>
        <span aria-hidden="true">→</span>
      </a>
    </section>

  </article>
</BaseLayout>

<style>
  .project-page {
    width: 100%;
    padding: 52px 0 120px;
  }

  .project-hero {
    min-height: 68vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 64px;
    border-bottom: 1px solid var(--line, #292929);
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }

  .eyebrow,
  .year,
  .section-label {
    margin: 0;
    color: var(--muted, #888);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .project-hero h1 {
    margin: 64px 0;
    font-size: clamp(68px, 11vw, 150px);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.065em;
  }

  .project-hero h1 span {
    color: var(--muted, #777);
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 680px) auto;
    align-items: end;
    justify-content: space-between;
    gap: 48px;
  }

  .hero-description {
    margin: 0;
    font-size: clamp(18px, 2vw, 25px);
    line-height: 1.5;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--fg, #f3f3f3);
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
  }

  .hero-image {
    margin-top: 72px;
    overflow: hidden;
    background: #111;
  }

  .hero-image img {
    display: block;
    width: 100%;
    max-height: 780px;
    object-fit: cover;
    object-position: center;
  }

  .overview-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    gap: 80px;
    padding: 100px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .section-heading h2 {
    margin: 18px 0 0;
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .overview-copy {
    display: grid;
    gap: 24px;
  }

  .overview-copy p {
    max-width: 720px;
    margin: 0;
    font-size: 18px;
    line-height: 1.75;
  }

  .project-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    padding: 58px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .project-details article p:last-child {
    margin: 18px 0 0;
    color: var(--fg, #f3f3f3);
    line-height: 1.8;
  }

  .content-section {
    padding: 100px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .content-section .section-heading {
    max-width: 800px;
    margin-bottom: 44px;
  }

  .section-intro {
    max-width: 680px;
    margin: 24px 0 0;
    font-size: 17px;
    line-height: 1.7;
  }

  .topology-grid,
  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  figure {
    margin: 0;
  }

  .topology-grid figure,
  .image-wrapper {
    overflow: hidden;
    background: #111;
  }

  .topology-grid img,
  .comparison-grid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 500ms ease,
      filter 300ms ease;
  }

  .topology-grid img {
    aspect-ratio: 4 / 3;
  }

  .comparison-grid img {
    aspect-ratio: 16 / 10;
  }

  .topology-grid figure:hover img,
  .comparison-grid figure:hover img {
    transform: scale(1.02);
    filter: brightness(1.05);
  }

  .comparison-grid figcaption {
    margin-top: 14px;
    color: var(--muted, #888);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reflection-section {
    display: grid;
    grid-template-columns: minmax(180px, 0.4fr) minmax(0, 1.6fr);
    gap: 60px;
    padding: 100px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .reflection-text {
    max-width: 820px;
    margin: 0;
    color: var(--fg, #f3f3f3);
    font-size: clamp(24px, 3.2vw, 46px);
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .next-project {
    padding-top: 90px;
  }

  .next-project a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-top: 26px;
    padding: 34px 0;
    color: inherit;
    text-decoration: none;
    border-top: 1px solid var(--line, #292929);
    border-bottom: 1px solid var(--line, #292929);
  }

  .next-project a span:first-child {
    font-size: clamp(34px, 6vw, 76px);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .next-project a span:last-child {
    font-size: 38px;
    transition: transform 200ms ease;
  }

  .next-project a:hover span:last-child {
    transform: translateX(8px);
  }

  @media (max-width: 800px) {
    .project-page {
      padding-top: 30px;
    }

    .project-hero {
      min-height: 58vh;
    }

    .hero-bottom,
    .overview-section,
    .reflection-section {
      grid-template-columns: 1fr;
    }

    .project-details {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .project-hero h1 {
      font-size: 58px;
    }

    .hero-meta {
      flex-direction: column;
    }

    .project-details,
    .topology-grid,
    .comparison-grid {
      grid-template-columns: 1fr;
    }

    .overview-section,
    .content-section,
    .reflection-section {
      padding: 74px 0;
    }

    .hero-image img {
      aspect-ratio: 4 / 5;
    }
  }
</style>