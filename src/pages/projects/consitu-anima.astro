---
import BaseLayout from "../../layouts/BaseLayout.astro";

const rigFeatures = [
  "Custom hand controls",
  "Finger articulation",
  "Skinning and weight adjustment",
  "Pose testing",
  "Animation-ready control setup",
];
---

<BaseLayout title="Constituyentes Station Icon — Rigging & Animation">
  <article class="project-page">

    <header class="project-hero">
      <div class="hero-top">
        <a class="back-link" href="/animation">← Back to Animation</a>
        <p class="year">2025</p>
      </div>

      <div class="hero-content">
        <p class="eyebrow">RIGGING · 3D ANIMATION · MOTION STUDY</p>

        <h1>
          Constituyentes<br />
          Station Icon<span>.</span>
        </h1>

        <div class="hero-bottom">
          <p class="intro">
            A rigging and animation study based on the hand symbol of the
            Constituyentes Metro station, focused on clear articulation,
            expressive posing and controlled movement.
          </p>

          <p class="software">Blender</p>
        </div>
      </div>
    </header>

    <section class="scope-section">
      <p class="section-label">PROJECT SCOPE</p>

      <div class="scope-content">
        <h2>Rigging and animation</h2>

        <p>
          My contribution to this project included the complete rigging and
          animation of the hand. The original model was obtained as an existing
          asset and was not modeled by me.
        </p>

        <p>
          I created the control system, adjusted the skinning and deformation,
          tested the articulation of the fingers and developed the final
          animation sequence.
        </p>
      </div>
    </section>

    <section class="details-grid">
      <article>
        <p class="section-label">MY ROLE</p>
        <p>
          Hand Rigging<br />
          Skinning<br />
          Weight Painting<br />
          3D Animation<br />
          Animation Polish
        </p>
      </article>

      <article>
        <p class="section-label">MODEL</p>
        <p>
          Existing 3D Asset<br />
          Model not created by me
        </p>
      </article>

      <article>
        <p class="section-label">SOFTWARE</p>
        <p>Blender</p>
      </article>
    </section>

    <section class="media-section">
      <div class="section-heading">
        <p class="section-label">FINAL ANIMATION</p>
        <h2>Constituyentes motion study</h2>

        <p class="section-intro">
          The final sequence explores the graphic identity of the station icon
          through controlled finger movement, clear silhouettes and a concise
          animation rhythm.
        </p>
      </div>

      <div class="featured-video">
        <video
          src="/work/animation/Consti/hand_consti.mp4"
          autoplay
          loop
          muted
          playsinline
          controls
          preload="metadata"
        >
          Your browser does not support the video tag.
        </video>

        <p class="caption">
          Final animation using the custom hand rig created for this project.
        </p>
      </div>
    </section>

    <section class="overview-section">
      <div class="section-heading">
        <p class="section-label">RIGGING APPROACH</p>
        <h2>Building clear hand articulation</h2>
      </div>

      <div class="overview-copy">
        <p>
          The rig was designed to provide direct control over the wrist,
          palm and individual fingers while maintaining a simple and readable
          setup.
        </p>

        <p>
          Because the hand is the central visual element, special attention was
          given to finger spacing, curved poses and silhouette clarity from the
          main camera angle.
        </p>
      </div>
    </section>

    <section class="media-section">
      <div class="section-heading">
        <p class="section-label">RIG BREAKDOWN</p>
        <h2>Controls and deformation</h2>

        <p class="section-intro">
          A look at the control system and deformation tests developed before
          producing the final animation.
        </p>
      </div>

      <div class="video-grid-2">
        <article class="video-item">
          <video
            src="/work/animation/Consti/rig-overview.mp4"
            autoplay
            loop
            muted
            playsinline
            controls
            preload="metadata"
          >
            Your browser does not support the video tag.
          </video>

          <div class="video-info">
            <p class="video-number">01</p>

            <div>
              <h3>Rig Overview</h3>
              <p>
                Overview of the hand controls, finger articulation and the
                general organization of the rig.
              </p>
            </div>
          </div>
        </article>

        <article class="video-item">
          <video
            src="/work/animation/Consti/weight.mp4"
            autoplay
            loop
            muted
            playsinline
            controls
            preload="metadata"
          >
            Your browser does not support the video tag.
          </video>

          <div class="video-info">
            <p class="video-number">02</p>

            <div>
              <h3>Deformation Test</h3>
              <p>
                Pose tests used to refine the weights around the fingers,
                knuckles, palm and wrist.
              </p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="features-section">
      <div>
        <p class="section-label">RIG FEATURES</p>
        <h2>Designed for expressive poses</h2>
      </div>

      <div class="features-list">
        {
          rigFeatures.map((feature, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{feature}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="media-section">
      <div class="section-heading">
        <p class="section-label">ANIMATION PROCESS</p>
        <h2>From blocking to final motion</h2>
      </div>

      <div class="video-grid-2">
        <article class="video-item">
          <video
            src="/work/animation/Consti/blocking.mp4"
            autoplay
            loop
            muted
            playsinline
            controls
            preload="metadata"
          >
            Your browser does not support the video tag.
          </video>

          <div class="video-info">
            <p class="video-number">03</p>

            <div>
              <h3>Blocking</h3>
              <p>
                Initial poses and timing used to define the main movement and
                ensure the hand remained readable.
              </p>
            </div>
          </div>
        </article>

        <article class="video-item">
          <video
            src="/work/animation/Consti/polish.mp4"
            autoplay
            loop
            muted
            playsinline
            controls
            preload="metadata"
          >
            Your browser does not support the video tag.
          </video>

          <div class="video-info">
            <p class="video-number">04</p>

            <div>
              <h3>Polish Pass</h3>
              <p>
                Final curve adjustments, finger overlap, spacing refinement and
                secondary movement.
              </p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="focus-section">
      <div>
        <p class="section-label">FOCUS AREAS</p>
        <h2>What I developed</h2>
      </div>

      <div class="focus-list">
        <article>
          <span>01</span>

          <div>
            <h3>Control setup</h3>
            <p>
              A simple control system for posing the wrist, palm and individual
              fingers efficiently.
            </p>
          </div>
        </article>

        <article>
          <span>02</span>

          <div>
            <h3>Skinning and deformation</h3>
            <p>
              Weight adjustments focused on preserving the volume of the hand
              during curved and compressed poses.
            </p>
          </div>
        </article>

        <article>
          <span>03</span>

          <div>
            <h3>Posing and silhouettes</h3>
            <p>
              Clear finger separation and readable poses based on the graphic
              identity of the original Metro icon.
            </p>
          </div>
        </article>

        <article>
          <span>04</span>

          <div>
            <h3>Animation polish</h3>
            <p>
              Refinement of timing, spacing and overlapping action to produce a
              more controlled final sequence.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="outcome-section">
      <p class="section-label">OUTCOME</p>

      <p class="outcome-text">
        This project allowed me to combine rigging and animation in a single
        workflow, strengthening my understanding of hand articulation,
        deformation and expressive motion using an existing model.
      </p>
    </section>

    <section class="next-project">
      <p class="section-label">NEXT ANIMATION PROJECT</p>

      <a href="/projects/wolf-walk-cycle">
        <span>Wolf Walk Cycle</span>
        <span aria-hidden="true">→</span>
      </a>
    </section>

  </article>
</BaseLayout>

<style>
  .project-page {
    width: 100%;
    padding: 52px 0 120px;
  }

  .project-hero {
    min-height: 76vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 68px;
    border-bottom: 1px solid var(--line, #292929);
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .back-link {
    color: var(--muted, #888);
    font-size: 14px;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .back-link:hover {
    color: var(--fg, #f3f3f3);
  }

  .year,
  .eyebrow,
  .section-label {
    margin: 0;
    color: var(--muted, #888);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .hero-content {
    margin-top: 72px;
  }

  .project-hero h1 {
    margin: 34px 0 68px;
    max-width: 1250px;
    font-size: clamp(58px, 9vw, 142px);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.065em;
  }

  .project-hero h1 span {
    color: var(--muted, #777);
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 720px) auto;
    justify-content: space-between;
    align-items: end;
    gap: 48px;
  }

  .intro {
    margin: 0;
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1.5;
  }

  .software {
    margin: 0;
    color: var(--muted, #888);
    font-size: 13px;
    white-space: nowrap;
  }

  .scope-section,
  .outcome-section {
    display: grid;
    grid-template-columns: minmax(180px, 0.4fr) minmax(0, 1.6fr);
    gap: 70px;
    padding: 90px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .scope-content {
    max-width: 820px;
  }

  .scope-content h2,
  .section-heading h2,
  .features-section h2,
  .focus-section h2 {
    margin: 18px 0 0;
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .scope-content h2 {
    margin-top: 0;
    margin-bottom: 28px;
  }

  .scope-content p {
    margin: 0 0 20px;
    font-size: 18px;
    line-height: 1.75;
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    padding: 58px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .details-grid article p:last-child {
    margin: 18px 0 0;
    color: var(--fg, #f3f3f3);
    line-height: 1.8;
  }

  .media-section {
    padding: 100px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .section-heading {
    max-width: 850px;
    margin-bottom: 46px;
  }

  .section-intro {
    max-width: 680px;
    margin: 24px 0 0;
    font-size: 17px;
    line-height: 1.7;
  }

  .featured-video video,
  .video-item video {
    display: block;
    width: 100%;
    background: #111;
    border: 1px solid var(--line, #292929);
  }

  .featured-video video {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .caption {
    margin: 14px 0 0;
    color: var(--muted, #888);
    font-size: 13px;
  }

  .overview-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    gap: 80px;
    padding: 100px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .overview-copy {
    display: grid;
    gap: 24px;
  }

  .overview-copy p {
    max-width: 720px;
    margin: 0;
    font-size: 18px;
    line-height: 1.75;
  }

  .video-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .video-item video {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .video-info {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 18px;
    margin-top: 18px;
  }

  .video-number {
    margin: 5px 0 0;
    color: var(--muted, #777);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .video-info h3,
  .focus-list h3 {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 500;
  }

  .video-info p,
  .focus-list p {
    margin: 0;
    line-height: 1.65;
  }

  .features-section,
  .focus-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
    gap: 80px;
    padding: 100px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .features-list,
  .focus-list {
    display: flex;
    flex-direction: column;
  }

  .features-list article,
  .focus-list article {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 22px;
    padding: 28px 0;
    border-top: 1px solid var(--line, #292929);
  }

  .features-list article:last-child,
  .focus-list article:last-child {
    border-bottom: 1px solid var(--line, #292929);
  }

  .features-list span,
  .focus-list article > span {
    color: var(--muted, #777);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .features-list p {
    margin: 0;
    font-size: 20px;
    line-height: 1.4;
  }

  .outcome-text {
    max-width: 860px;
    margin: 0;
    color: var(--fg, #f3f3f3);
    font-size: clamp(24px, 3.2vw, 46px);
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .next-project {
    padding-top: 90px;
  }

  .next-project a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-top: 26px;
    padding: 34px 0;
    color: inherit;
    text-decoration: none;
    border-top: 1px solid var(--line, #292929);
    border-bottom: 1px solid var(--line, #292929);
  }

  .next-project a span:first-child {
    font-size: clamp(34px, 6vw, 76px);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .next-project a span:last-child {
    font-size: 38px;
    transition: transform 200ms ease;
  }

  .next-project a:hover span:last-child {
    transform: translateX(8px);
  }

  @media (max-width: 850px) {
    .project-hero {
      min-height: 62vh;
    }

    .hero-bottom,
    .scope-section,
    .overview-section,
    .features-section,
    .focus-section,
    .outcome-section {
      grid-template-columns: 1fr;
    }

    .details-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 650px) {
    .project-page {
      padding-top: 30px;
    }

    .project-hero h1 {
      font-size: 48px;
    }

    .details-grid,
    .video-grid-2 {
      grid-template-columns: 1fr;
    }

    .scope-section,
    .overview-section,
    .media-section,
    .features-section,
    .focus-section,
    .outcome-section {
      padding: 74px 0;
    }

    .software {
      white-space: normal;
    }
  }
</style>