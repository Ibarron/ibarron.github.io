---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Wolf Character — Production-Ready Rig">
  <section class="project">
    <a class="back" href="/work">← Back to Work</a>

    <header class="hero">
      <h1>Wolf Character — Production-Ready Rig</h1>
      <p class="meta">Blender · Character Modeling · Rigging · Animation · 2026</p>

      <p class="intro">
        Full character project built from scratch: sculpt → retopology → Texturing → rigging → animation tests.
        The rig includes IK/FK switching, space switching, stretch systems, foot roll, and facial controls.
      </p>
    </header>

    <!-- TOP ROW: 2 VIDEOS -->
    <section class="video-grid-2">
      <div class="video-item">
        <video
          src="/work/Wolf_Rigging/angryface.mp4"
          autoplay
          loop
          muted
          playsinline
          controls
          preload="metadata"
        ></video>
        <p class="caption">Facial controls and expression preview.</p>
      </div>

      <div class="video-item">
        <video
          src="/work/Wolf_Rigging/walking.mp4"
          autoplay
          loop
          muted
          playsinline
          controls
          preload="metadata"
        ></video>
        <p class="caption">Walk cycle and full rig motion preview.</p>
      </div>
    </section>

    <!-- BOTTOM ROW: 3 VIDEOS -->
    <section class="video-grid-3">
      <div class="video-item">
        <video
          src="/work/Wolf_Rigging/rig-overview.mp4"
          autoplay
          loop
          muted
          playsinline
          controls
          preload="metadata"
        ></video>
        <p class="caption">Rig overview and control system preview.</p>
      </div>

      <div class="video-item">
        <video
          src="/work/Wolf_Rigging/stretch_ankle.mp4"
          autoplay
          loop
          muted
          playsinline
          controls
          preload="metadata"
        ></video>
        <p class="caption">Stretch and ankle deformation test.</p>
      </div>

      <div class="video-item">
        <video
          src="/work/Wolf_Rigging/IK_FK0001-0114.mp4"
          autoplay
          loop
          muted
          playsinline
          controls
          preload="metadata"
        ></video>
        <p class="caption">IK/FK switching system demonstration.</p>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .project {
    max-width: 1100px;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-top: 12px;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--fg);
  }

  .hero {
    margin-top: 24px;
    max-width: 820px;
  }

  .meta {
    margin-top: 8px;
    color: var(--muted);
  }

  .intro {
    margin-top: 18px;
    color: var(--muted);
    line-height: 1.7;
  }

  .video-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .video-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 24px;
  }

  .video-item video {
    width: 100%;
    display: block;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .caption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .video-grid-2,
    .video-grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>