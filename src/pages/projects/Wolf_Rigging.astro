---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Wolf Character — Production-Ready Rig">

  <section class="project">
    <a class="back" href="/work">← Back to Work</a>

    <header class="hero">
      <h1>Wolf Character — Production-Ready Rig</h1>
      <p class="meta">Blender · Character Modeling · Rigging · Animation · 2026</p>

      <p class="intro">
        Full character project built from scratch: sculpt → retopology → rigging → animation tests.
        The rig includes IK/FK switching, space switching, stretch systems, foot roll, and facial controls.
      </p>
    </header>

    <!-- =========================
         FEATURED VIDEO
         ========================= -->
    <section class="video">
  <video
    src="/work/Wolf_Rigging/rig-overview.mp4"
    autoplay
    loop
    muted
    playsinline
    controls
    preload="metadata"
  ></video>

  <p class="caption">
    Viewport preview showcasing modeling and motion tests.
  </p>
 

   <video
    src="/work/Wolf_Rigging/Rig_body.mp4"
    autoplay
    loop
    muted
    playsinline
    controls
    preload="metadata"
  ></video>

  <p class="caption">
    Viewport preview body rigging.
  </p>

    </section>

    <!-- =========================
         OPTIONAL: IMAGES SECTION
         ========================= -->
 

  </section>

</BaseLayout>

<style>
.video {
  max-width: 960px;
  margin: 0 auto 64px;
}
.project {
  max-width: 1100px;
  margin: 0 auto;
}

.back {
  display: inline-block;
  margin-top: 12px;
  color: var(--muted);
  text-decoration: none;
}

.back:hover {
  color: var(--fg);
}

.hero {
  margin-top: 24px;
  max-width: 820px;
}

.meta {
  margin-top: 8px;
  color: var(--muted);
}

.intro {
  margin-top: 18px;
  color: var(--muted);
  line-height: 1.7;
}

.block {
  margin-top: 56px;
}

video {
  width: 100%;
  display: block;
  border: 1px solid var(--line);
  border-radius: 6px;
  margin-top: 14px;
}

.grid {
  margin-top: 18px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.card h3 {
  margin: 0 0 10px;
  font-size: 14px;
  color: var(--fg);
}

.muted {
  color: var(--muted);
}

@media (max-width: 900px) {
  .grid {
    grid-template-columns: 1fr;
  }
}
</style>