---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Juan Pablo Ibarron — 3D Artist, Animator and Content Creator."
    />
    <link rel="icon" href="/favicon.svg" />
    <title>Links — Juan Pablo Ibarron</title>
  </head>

  <body>
    <main class="links-page">

      <!-- PROFILE -->
      <header class="profile">

        <div class="avatar">
          <img
            src="/work/profile.jpg"
            alt="Juan Pablo Ibarron"
          />
        </div>

        <p class="username">@ibarron</p>

        <h1>Juan Pablo<br />Ibarron<span>.</span></h1>

        <p class="role">
          3D Artist · Animator · Content Creator
        </p>

        <p class="bio">
          Exploring animation, storytelling and the creative world
          behind the screen.
        </p>

      </header>

      <!-- SOCIAL LINKS -->
      <nav class="social-icons" aria-label="Social media">
        {
          links
            .filter((link) =>
              ["instagram", "tiktok", "youtube", "facebook"].includes(link.icon)
            )
            .map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.title}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[link.icon]}
                />
              </a>
            ))
        }
      </nav>

      <div class="divider"></div>

      <!-- MAIN LINKS -->
      <section class="link-list" aria-label="All links">

        <p class="section-label">EXPLORE MY WORK</p>

        {
          links.map((link) => (
            <a
              class="link-card"
              href={link.url}
              target={link.url.startsWith("https") ? "_blank" : "_self"}
              rel="noopener noreferrer"
            >

              <div class="link-icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[link.icon]}
                />
              </div>

              <div class="link-content">
                <h2>{link.title}</h2>
                <p>{link.subtitle}</p>
              </div>

              <span class="arrow" aria-hidden="true">↗</span>

            </a>
          ))
        }

      </section>

      <!-- FOOTER -->
      <footer>
        <a href="/">IBARRON<span>.</span></a>
        <p>Created with curiosity.</p>
        <p class="copyright">
          © {new Date().getFullYear()} Juan Pablo Ibarron
        </p>
      </footer>

    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #0d0d0d;
    color: #f2f2f2;
    font-family: "Inter", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .links-page {
    width: min(100% - 40px, 520px);
    margin: 0 auto;
    padding: 65px 0 40px;
  }

  .profile {
    text-align: center;
  }

  .avatar {
    width: 120px;
    height: 120px;
    margin: 0 auto 24px;
    border-radius: 50%;
    border: 1px solid #454545;
    overflow: hidden;
    background: #232323;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .username {
    color: #888;
    font-size: 13px;
    margin: 0 0 16px;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-size: clamp(38px, 9vw, 58px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  h1 span {
    color: #777;
  }

  .role {
    color: #b5b5b5;
    font-size: 14px;
    margin: 22px 0 12px;
  }

  .bio {
    max-width: 340px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.7;
    color: #858585;
  }

  .social-icons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    margin: 28px 0;
  }

  .social-icons a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: #ccc;
    transition: transform 200ms, color 200ms;
  }

  .social-icons a:hover {
    color: white;
    transform: translateY(-4px);
  }

  .social-icons svg {
    width: 23px;
    height: 23px;
  }

  .divider {
    height: 1px;
    background: #282828;
    margin: 35px 0;
  }

  .section-label {
    margin: 0 0 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: #777;
  }

  .link-list {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .link-card {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 24px;
    align-items: center;
    gap: 15px;
    min-height: 80px;
    padding: 18px 20px;
    background: #171717;
    border: 1px solid #303030;
    border-radius: 12px;
    text-decoration: none;
    color: #f2f2f2;
    transition:
      background 250ms ease,
      border-color 250ms ease,
      transform 250ms ease;
  }

  .link-card:hover {
    background: #242424;
    border-color: #666;
    transform: translateY(-3px);
  }

  .link-card:focus-visible,
  .social-icons a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .link-icon svg {
    width: 24px;
    height: 24px;
  }

  .link-content h2 {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 6px;
  }

  .link-content p {
    font-size: 12px;
    line-height: 1.4;
    color: #888;
    margin: 0;
  }

  .arrow {
    color: #888;
    font-size: 20px;
    text-align: right;
    transition: transform 200ms;
  }

  .link-card:hover .arrow {
    color: #fff;
    transform: translate(2px, -2px);
  }

  footer {
    text-align: center;
    padding-top: 55px;
  }

  footer a {
    text-decoration: none;
    color: #ddd;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  footer a span {
    color: #777;
  }

  footer p {
    font-size: 12px;
    color: #777;
  }

  footer .copyright {
    margin-top: 24px;
    font-size: 10px;
    color: #666;
  }

  @media (max-width: 480px) {
    .links-page {
      width: calc(100% - 32px);
      padding-top: 40px;
    }

    .avatar {
      width: 100px;
      height: 100px;
    }

    .link-card {
      padding: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
