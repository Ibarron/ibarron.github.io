---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    number: "01",
    title: "Maki (Dog Character)",
    category: "Character Modeling · Retopology · Texturing",
    description:
      "A stylized quadruped character developed from modeling and manual retopology to hand-painted textures and an animation-ready production mesh.",
    image: "/work/modeling/wolf/wolf-hero.png",
    link: "/projects/wolf-modeling",
  },

  {
    number: "02",
    title: "Mixcoac Station",
    category: "Environment Modeling · 3D Rendering",
    description:
      "A stylized 3D environment inspired by Mixcoac Station, focused on architectural modeling, composition and visual presentation.",
    image: "/work/Mixcoac/mixcoac-hero.jpg",
    link: "/projects/mixcoac-station",
  },

  {
    number: "03",
    title: "Serpent Icon",
    category: "Stylized Modeling · Look Development",
    description:
      "A stylized serpent icon created through a compact modeling and rendering workflow, designed as a graphic 3D asset.",
    image: "/work/Serpent/serpent-hero.jpg",
    link: "/projects/serpent-icon",
  },
];
---

<BaseLayout title="Modeling — Juan Pablo Ibarron">
  <main class="modeling-page">

    <section class="modeling-hero">
      <p class="eyebrow">SELECTED DISCIPLINE</p>

      <h1>Modeling<span>.</span></h1>

      <div class="hero-bottom">
        <p class="intro">
          A selection of characters and environments developed through
          modeling, retopology, UV creation and texturing.
        </p>

        <p class="project-count">
          {String(projects.length).padStart(2, "0")} PROJECTS
        </p>
      </div>
    </section>

    <section class="project-list">
      {
        projects.map((project) => (
          <article class="project">
            <a href={project.link} class="project-link">

              <div class="project-heading">
                <p class="project-number">{project.number}</p>

                <div>
                  <h2>{project.title}</h2>
                  <p class="category">{project.category}</p>
                </div>

                <span class="arrow" aria-hidden="true">↗</span>
              </div>

              <div class="project-image">
                <img
                  src={project.image}
                  alt={`${project.title} project`}
                  loading="lazy"
                />
              </div>

              <div class="project-footer">
                <p>{project.description}</p>

                <span class="view-project">
                  View project
                  <span aria-hidden="true">→</span>
                </span>
              </div>

            </a>
          </article>
        ))
      }
    </section>

  </main>
</BaseLayout>

<style>
  .modeling-page {
    width: min(100% - 48px, 1440px);
    margin: 0 auto;
    padding: 100px 0 140px;
  }

  .modeling-hero {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 72px;
    border-bottom: 1px solid var(--line, #292929);
  }

  .eyebrow {
    margin: 0;
    color: var(--muted, #888);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .modeling-hero h1 {
    margin: 70px 0;
    font-size: clamp(82px, 15vw, 220px);
    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.065em;
  }

  .modeling-hero h1 span {
    color: var(--muted, #777);
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 700px) auto;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
  }

  .intro {
    margin: 0;
    color: var(--muted, #a5a5a5);
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1.45;
  }

  .project-count {
    margin: 0;
    color: var(--muted, #888);
    font-size: 12px;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  .project-list {
    display: flex;
    flex-direction: column;
  }

  .project {
    padding: 78px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .project-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project-heading {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    align-items: start;
    gap: 24px;
    margin-bottom: 34px;
  }

  .project-number {
    margin: 9px 0 0;
    color: var(--muted, #777);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .project-heading h2 {
    margin: 0 0 12px;
    font-size: clamp(38px, 5vw, 78px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .category {
    margin: 0;
    color: var(--muted, #999);
    font-size: 14px;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line, #333);
    border-radius: 50%;
    font-size: 21px;
    transition:
      transform 250ms ease,
      background-color 250ms ease,
      color 250ms ease;
  }

  .project-image {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition:
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 400ms ease;
  }

  .project-footer {
    display: grid;
    grid-template-columns: minmax(0, 700px) auto;
    justify-content: space-between;
    align-items: start;
    gap: 40px;
    margin-top: 26px;
  }

  .project-footer p {
    margin: 0;
    color: var(--muted, #999);
    line-height: 1.65;
  }

  .view-project {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
    font-size: 14px;
  }

  .project-link:hover .project-image img {
    transform: scale(1.025);
    filter: brightness(1.06);
  }

  .project-link:hover .arrow {
    transform: rotate(45deg);
    background: #f2f2f2;
    color: #111;
  }

  @media (max-width: 800px) {
    .modeling-page {
      width: min(100% - 30px, 1440px);
      padding-top: 70px;
    }

    .modeling-hero {
      min-height: 58vh;
      padding-bottom: 48px;
    }

    .modeling-hero h1 {
      margin: 70px 0;
    }

    .hero-bottom,
    .project-footer {
      grid-template-columns: 1fr;
    }

    .project-count {
      display: none;
    }

    .project {
      padding: 56px 0;
    }

    .project-heading {
      grid-template-columns: 42px 1fr;
    }

    .arrow {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .modeling-page {
      width: min(100% - 24px, 1440px);
    }

    .modeling-hero h1 {
      font-size: 68px;
    }

    .project-heading {
      grid-template-columns: 1fr;
    }

    .project-number {
      margin: 0;
    }

    .project-image {
      aspect-ratio: 4 / 5;
    }
  }
</style>