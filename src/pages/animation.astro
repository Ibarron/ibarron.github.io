---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    number: "01",
    title: "Metro icon Mixcoac ",
    category: "3D Animation · Motion Design · Blender",
    description:
      "A short 3D animation exploring movement, timing and visual transitions through an iconic symbol from Mexico City's Metro system.",
    video: "/work/animation/Mixcoac_icono/mixcoac_icono.mp4",
    poster: "/work/animation/metro-symbol-01.jpg",
    link: "/projects/mixcoac-icono",
  },
  {
    number: "02",
    title: "Metro icon Constituyentes",
    category: "3D Animation · Motion Design · Blender",
    description:
      "A second animation study focused on transforming a familiar Metro symbol into a dynamic three-dimensional sequence.",
    video: "/work/animation/Consti/hand_consti.mp4",
    poster: "/work/animation/Consti/consti.png",
    link: "/projects/consitu-anima",
  },
  {
    number: "03",
    title: "Wolf Walk Cycle",
    category: "Character Animation · Quadruped Animation · Blender",
    description:
      "A quadruped walk cycle developed to test weight distribution, rhythm, body mechanics and deformation on the fully rigged wolf character.",
    video: "/work/animation/wolf_ani/walking_wolf.mp4",
    poster: "/work/animation/wolf-walk-cycle.jpg",
    link: "/projects/wolf_ani",
  },
];
---

<BaseLayout title="Animation — Juan Pablo Ibarron">
  <main class="animation-page">

    <section class="animation-hero">
      <p class="eyebrow">SELECTED DISCIPLINE</p>

      <h1>Animation<span>.</span></h1>

      <div class="hero-bottom">
        <p class="intro">
          A selection of character animation and motion studies focused on
          timing, movement, visual rhythm and expressive storytelling.
        </p>

        <p class="project-count">
          {String(projects.length).padStart(2, "0")} PROJECTS
        </p>
      </div>
    </section>

    <section class="project-list">
      {
        projects.map((project) => (
          <article class="project">
            <a href={project.link} class="project-link">

              <div class="project-heading">
                <p class="project-number">{project.number}</p>

                <div class="project-title">
                  <h2>{project.title}</h2>
                  <p class="category">{project.category}</p>
                </div>

                <span class="arrow" aria-hidden="true">↗</span>
              </div>

              <div class="project-media">
                <video
                  src={project.video}
                  poster={project.poster}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label={`${project.title} preview`}
                >
                  Your browser does not support the video tag.
                </video>
              </div>

              <div class="project-footer">
                <p>{project.description}</p>

                <span class="view-project">
                  View project
                  <span aria-hidden="true">→</span>
                </span>
              </div>

            </a>
          </article>
        ))
      }
    </section>

  </main>
</BaseLayout>

<style>
  .animation-page {
    width: min(100% - 48px, 1440px);
    max-width: none;
    margin: 0 auto;
    padding: 100px 0 140px;
  }

  .animation-hero {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 72px;
    border-bottom: 1px solid var(--line, #292929);
  }

  .eyebrow {
    margin: 0;
    color: var(--muted, #888);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .animation-hero h1 {
    margin: 70px 0;
    font-size: clamp(82px, 15vw, 220px);
    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.065em;
  }

  .animation-hero h1 span {
    color: var(--muted, #777);
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 700px) auto;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
  }

  .intro {
    margin: 0;
    color: var(--muted, #aaa);
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1.5;
  }

  .project-count {
    margin: 0;
    color: var(--muted, #888);
    font-size: 12px;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  .project-list {
    display: flex;
    flex-direction: column;
  }

  .project {
    padding: 78px 0;
    border-bottom: 1px solid var(--line, #292929);
  }

  .project-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project-heading {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) auto;
    align-items: start;
    gap: 24px;
    margin-bottom: 34px;
  }

  .project-number {
    margin: 9px 0 0;
    color: var(--muted, #777);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .project-heading h2 {
    margin: 0 0 12px;
    font-size: clamp(38px, 5vw, 78px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .category {
    margin: 0;
    color: var(--muted, #999);
    font-size: 14px;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line, #333);
    border-radius: 50%;
    font-size: 21px;
    transition:
      transform 250ms ease,
      background-color 250ms ease,
      color 250ms ease;
  }

  .project-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
  }

  .project-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    transition:
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 400ms ease;
  }

  .project-footer {
    display: grid;
    grid-template-columns: minmax(0, 700px) auto;
    justify-content: space-between;
    align-items: start;
    gap: 40px;
    margin-top: 26px;
  }

  .project-footer p {
    margin: 0;
    color: var(--muted, #999);
    line-height: 1.65;
  }

  .view-project {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 14px;
    white-space: nowrap;
  }

  .project-link:hover .project-media video {
    transform: scale(1.025);
    filter: brightness(1.07);
  }

  .project-link:hover .arrow {
    transform: rotate(45deg);
    background: #f2f2f2;
    color: #111;
  }

  @media (max-width: 800px) {
    .animation-page {
      width: min(100% - 30px, 1440px);
      padding-top: 70px;
    }

    .animation-hero {
      min-height: 58vh;
      padding-bottom: 48px;
    }

    .hero-bottom,
    .project-footer {
      grid-template-columns: 1fr;
    }

    .project-count {
      display: none;
    }

    .project {
      padding: 56px 0;
    }

    .project-heading {
      grid-template-columns: 42px minmax(0, 1fr);
    }

    .arrow {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .animation-page {
      width: min(100% - 24px, 1440px);
    }

    .animation-hero h1 {
      font-size: 68px;
    }

    .project-heading {
      grid-template-columns: 1fr;
    }

    .project-number {
      margin: 0;
    }

    .project-media {
      aspect-ratio: 4 / 5;
    }
  }
</style>